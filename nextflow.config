params {
        // =====================================
        // INPUT/OUTPUT
        // =====================================

        // Prediction run name. Only letters, numbers, underscores, and dashes allowed.
        pred_name = 'test'
        // Output directory. Existing results will be overwritten
        out_dir = '/vast/scratch/users/hardy.j/boltztest'
        // Input YAML file. If provided, parameters below will be ignored. The name of the yaml file will be the prediction name.
        input_yaml = '/home/users/allstaff/hardy.j/boltzpipeline/nf-boltz/testfolder'

        // =====================================
        // SEQUENCES (Proteins, DNA, RNA)
        // =====================================
        
        // Choose from 'protein', 'dna', 'rna'
        seq1_type = 'protein'
        
        // Unique ID(s)
        seq1_id = 'A'
        
        // Sequence
        seq1_seq = 'ADNKFNKEQQNAFYEILHLPNLTEEQRNGFIQSLKDDPSVSKEILAEAKKLNDAQAPK'
        
        // Sequence modifications [RESIDX,CCD][RESIDX,CCD]...
        seq1_mod = '[33,SEP][42,SEP]'
        
        // Is sequence cyclic?
        seq1_cyclic = false
        
        // Whether to generate MSA
        seq1_genmsa = true
        
        seq2_type = null
        seq2_id = null
        seq2_seq = null
        seq2_mod = null
        seq2_cyclic = false
        seq2_genmsa = true

        seq3_type = null
        seq3_id = null
        seq3_seq = null
        seq3_mod = null
        seq3_cyclic = false
        seq3_genmsa = true

        seq4_type = null
        seq4_id = null
        seq4_seq = null
        seq4_mod = null
        seq4_cyclic = false
        seq4_genmsa = true

        seq5_type = null
        seq5_id = null
        seq5_seq = null
        seq5_mod = null
        seq5_cyclic = false
        seq5_genmsa = true

        seq6_type = null
        seq6_id = null
        seq6_seq = null
        seq6_mod = null
        seq6_cyclic = false
        seq6_genmsa = true

        seq7_type = null
        seq7_id = null
        seq7_seq = null
        seq7_mod = null
        seq7_cyclic = false
        seq7_genmsa = true

        seq8_type = null
        seq8_id = null
        seq8_seq = null
        seq8_mod = null
        seq8_cyclic = false
        seq8_genmsa = true

        seq9_type = null
        seq9_id = null
        seq9_seq = null
        seq9_mod = null
        seq9_cyclic = false
        seq9_genmsa = true

        seq10_type = null
        seq10_id = null
        seq10_seq = null
        seq10_mod = null
        seq10_cyclic = false
        seq10_genmsa = true

        seq11_type = null
        seq11_id = null
        seq11_seq = null
        seq11_mod = null
        seq11_cyclic = false
        seq11_genmsa = true

        seq12_type = null
        seq12_id = null
        seq12_seq = null
        seq12_mod = null
        seq12_cyclic = false
        seq12_genmsa = true

        // =====================================
        // LIGANDS (Small molecules, ions, etc.)
        // =====================================

        // Unique ID(s) e.g. 'D'
        lig1_id = null
        // Choose from 'CCD' or 'SMILES'
        lig1_type = null
        // CCD/SMILES string e.g. 'ZN', '[Ca+2]'
        lig1_chem = null

        lig2_id = null
        lig2_type = null
        lig2_chem = null

        lig3_id = null
        lig3_type = null
        lig3_chem = null

        lig4_id = null
        lig4_type = null
        lig4_chem = null

        lig5_id = null
        lig5_type = null
        lig5_chem = null

        lig6_id = null
        lig6_type = null
        lig6_chem = null

        lig7_id = null
        lig7_type = null
        lig7_chem = null

        lig8_id = null
        lig8_type = null
        lig8_chem = null

        lig9_id = null
        lig9_type = null
        lig9_chem = null

        lig10_id = null
        lig10_type = null
        lig10_chem = null

        lig11_id = null
        lig11_type = null
        lig11_chem = null

        lig12_id = null
        lig12_type = null
        lig12_chem = null

        // =====================================
        // CONSTRAINTS
        // =====================================
        // Bond pairs '[CHAIN_ID,RES_IDX, ATOM_NAME][CHAIN_ID, RES_IDX, ATOM_NAME] [CHAIN_ID,RES_IDX, ATOM_NAME][CHAIN_ID, RES_IDX, ATOM_NAME]...'
        constraints_bond = null
        // Pocket binder ID
        pocket_binder_id = null
        // Pocket contact residues '[CHAIN_ID, RES_IDX][CHAIN_ID, RES_IDX]...'
        pocket_contacts = null

        // =====================================
        // BOLTZ-1 PARAMETERS
        // =====================================
        // The number of recycling steps to use for prediction. (default: 5)
        boltz_recycling_steps = 5
        // The number of diffusion samples to use for prediction. (default: 1)
        boltz_diffusion_samples = 1
        // The number of sampling steps to use for prediction. (default: 200)
        boltz_sampling_steps = 200
        // Additional configuration parameters to pass to Boltz-1 that are not externalised in Nextflow. e.g. '--msa_pairing_strategy complete'
        boltz_extra_config = null
        // GPU model requested (choose from 'A30' or 'A100')
        gpu_model = 'A30'
        // Number of CPUs requested
        n_cpus = 24
        // Memory requested
        memory = '48G'
}
