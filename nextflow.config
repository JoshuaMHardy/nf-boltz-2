params {
        // =====================================
        // INPUT/OUTPUT
        // =====================================

        // Prediction run name. Only letters, numbers, underscores, and dashes allowed.
        pred_name = 'test'
        // Output directory. Existing results will be overwritten
        outdir = '/vast/scratch/users/hardy.j/boltztest'
        // Input YAML file. If provided, parameters below will be ignored. The name of the yaml file will be the prediction name.
        input_yaml = null

        // =====================================
        // SEQUENCES (Proteins, DNA, RNA)
        // =====================================

        // Explicit sequence fields (up to 4)
        seq1_type = 'protein'                    // Choose from dna, rna, or protein
        seq1_chain_id = 'A'                 // Unique ID(s), e.g. 'A'
        seq1_seq = 'ADNKFNKEQQNAFYEILHLPNLTEEQRNGFIQSLKDDPSVSKEILAEAKKLNDAQAPK' // Required for each sequence
        seq1_mod = null                     // Sequence modifications [RESIDX,CCD][RESIDX,CCD]...
        seq1_cyclic = false                 // Is sequence cyclic?
        seq1_genmsa = true                  // Whether to generate MSA (for proteins)

        seq2_type = null
        seq2_chain_id = null
        seq2_seq = null
        seq2_mod = null
        seq2_cyclic = false
        seq2_genmsa = true

        seq3_type = null
        seq3_chain_id = null
        seq3_seq = null
        seq3_mod = null
        seq3_cyclic = false
        seq3_genmsa = true

        seq4_type = null
        seq4_chain_id = null
        seq4_seq = null
        seq4_mod = null
        seq4_cyclic = false
        seq4_genmsa = true

        // --- Extra sequences ---
        // Advanced: Space-separated blocks, each block: [ID(s)][SEQUENCE]
        // Example: '[E][MSEEKMIKDFE] [F,G][ACTGACTG]'
        // IDs can be comma-separated for multi-chain sequences.
        // Sequence type is auto-detected and MSA will be generated for protein sequences. Modifications are not supported. 
        sequences_extra = null

        // =====================================
        // LIGANDS (Small molecules, ions, etc.)
        // =====================================
        
        lig1_chain_id = null // Unique ID(s) e.g. 'D'. Use multiple ID's for more than one copy e.g. 'D,E'
        lig1_ccd = null // CCD code e.g. 'ZN', 'ATP'
        lig1_smiles = null  // SMILES string e.g. 'CCO', '[Ca+2]', 'CC(=O)Nc1ccc(O)cc1)''. If provided, CCD will be ignored.

        lig2_chain_id = null
        lig2_ccd = null
        lig2_smiles = null

        lig3_chain_id = null
        lig3_ccd = null
        lig3_smiles = null

        lig4_chain_id = null
        lig4_ccd = null
        lig4_smiles = null

        // --- Extra ligands ---
        // Advanced: Space-separated blocks, each: [ID(s)][CCD][SMILES]
        // Only a CCD or SMILES is needed, leave the other blank. IDs can be comma-separated for multiple copies of ligands.
        // Example: '[G,H][ZN][] [I][][C1CCCCC1]'
        ligands_extra = null

        // =====================================
        // CONSTRAINTS
        // =====================================
        // Bond constraints. Each bond constraint is provided as a pair of atoms. Multiple bonds can be specified, seperated by spaces.
        // For both atoms that form each bond, provide the chain ID, res number, and atom name.
        // Format: '[CHAIN_ID, RES_IDX, ATOM_NAME][CHAIN_ID, RES_IDX, ATOM_NAME] [CHAIN_ID,RES_IDX, ATOM_NAME][CHAIN_ID, RES_IDX, ATOM_NAME]...'
        // e.g. '[A,33,O][B,1,N] [H,95,SG][L,23,SG]'
        constraints_bond = null
        // Contact constraints provided as pairs of residues or atoms. Multiple contacts can be specified, seperated by spaces.
        // For each contact, provide: a pair of residue/atoms with their chain IDs. Optionally provide a max distance in Angstroms (default: 6) and whether to use a potential to enforce the contact (default: false).
        // Format: '[CHAIN_ID,RES_IDX/ATOM_NAME][CHAIN_ID,RES_IDX/ATOM_NAME][DIST_ANGSTROM][FORCE_BOOLEAN]'
        // e.g. '[A,53][A,57] [A,101][A,130][5][true]'        
        constraints_contacts = null

        // =====================================
        // POCKET CONSTRAINTS
        // =====================================

        // If more than two pockets are required, use `constraints_pocket_extra`.
        // --- Pocket 1 ---
        constraints_pocket1_binder = null        // (string) Chain ID of ligand/binder, e.g. 'B'
        constraints_pocket1_contacts =  null      // (string) List of pocket residues/atoms. Format: '[CHAIN_ID,IDX/ATOM]' comma-separated, e.g. '[A,53],[A,57],[A,61]'
        constraints_pocket1_max_distance = null  // (float, optional) Max distance (Å), e.g. 5. Default: 6 if not provided.
        constraints_pocket1_force = null        // (bool, optional) Whether to enforce pocket potential, true/false. Default: false.

        // --- Pocket 2 ---
        constraints_pocket2_binder = null
        constraints_pocket2_contacts = null
        constraints_pocket2_max_distance = null
        constraints_pocket2_force = null

        // --- Extra pockets ---
        // For advanced users who require >2 pockets, specify the remaining pockets as multi-block strings separated by spaces:
        // Format for each pocket: '[BINDER][[CONTACTS]][MAX_DISTANCE][FORCE_BOOLEAN]'
        // Example: '[D][[A,5],[B,12]] [E][[B,99],[C,1]][4][true]'
        constraints_pocket_extra = null     // (string or null)

        // =====================================
        // TEMPLATES
        // =====================================

        // If more than two pockets are required, use `template_extra`.
        // Up to two templates can be specified with explicit parameters.
        // Each consists of:
        //   - path          (string, required): Path to CIF file.
        //   - template_id   (string, optional): Template chain(s), comma-separated. Leave blank for auto-match.
        //   - prediction_id (string, optional): Prediction chain(s), comma-separated. Leave blank for auto-match.
        //   - threshold     (float, optional): If given, restricts max RMSD (Angstrom) between template and prediction using a force potential. 

        template1_path = null                // (string)
        template1_template_id = null         // (string, optional)
        template1_prediction_id = null       // (string, optional)
        template1_threshold = null           // (float, optional) If omitted, no force potential is used for this template.

        template2_path = null
        template2_template_id = null
        template2_prediction_id = null
        template2_threshold = null

        // --- Extra templates ---
        // For advanced or batch use, specify additional templates as a single multi-block string, in format:
        // '[CIF_PATH][PREDICTION_IDS][TEMPLATE_IDS][THRESHOLD]'
        // e.g. '[./x.cif][A][X][5] [./y.cif][B][Y][4]'
        // If threshold is omitted, no force is applied. If present, force is on.
        template_extra = null

        // =====================================
        // AFFINITY
        // =====================================
        // Chain ID of ligand for affinity calculations e.g. 'E', 'L1', 'D'
        affinity_ligand_id = null
        // Whether to add the Molecular Weight correction to the affinity value head. Boolean.
        affinity_mw_correction = false
        // The number of diffusion samples to use for affinity prediction. More samples improve quality but increase computation time. Default: 5 
        diffusion_samples_affinity = null
        // Number of sampling steps for affinity prediction. Default: 200
        sampling_steps_affinity = null

        // =====================================
        // BOLTZ-2 PARAMETERS
        // =====================================

        // The number of diffusion samples to use for prediction. (default: 1)
        diffusion_samples = 5
        // Method conditioning to use. (default: 'x-ray crystallography')
        // Choose from: 'afdb', 'boltz-1', 'md', 'electron microscopy', 'solution-nmr', 'x-ray crystallography', or 'other' 
        method = null
        // The number of recycling steps to use for prediction. (default: 3)
        recycling_steps = 10
        // The number of sampling steps to use for prediction. (default: 200)
        sampling_steps = null
        // Boltz prediction output format. Choose from 'mmcif' or 'pdb' (default: 'pdb')
        output_format = 'pdb'
        // Whether to save the full PAE matrix as a file
        write_full_pae = true
        // Whether to save the full PDE matrix as a file
        write_full_pde = true
        // Additional configuration parameters to pass to Boltz-2 that are not externalised in Nextflow. e.g. '--msa_pairing_strategy complete'
        extra_config = null
        // Path to the Boltz-2 container
        container_path = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/21_05/boltz2.sif'
        // Path to the Boltz-2 models
        models_path = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/boltzmodels'
        // GPU model requested (choose from 'A30' or 'A100')
        gpu_model = 'A30'
        // Number of CPUs requested
        n_cpus = 24
        // Memory requested
        memory = '48G'
}
profiles {
    // =============================================
    // PROFILE 1: DCLK1 kinase + DCLK1-IN-1 (SMILES)
    // =============================================
    dclk1_inhibitor {
        params {
            pred_name = 'dclk1_inhibitor'
            
            // DCLK1 human kinase domain 
            seq1_type = 'protein'
            seq1_chain_id = 'A'
            seq1_seq = 'YKVGRTIGDGNFAVVKECVERSTAREYALKIIKKSKCRGKEHMIQNEVSILRRVKHPNIVLLIEEMDVPTELYLVMELVKGGDLFDAITSTNKYTERDASGMLYNLASAIKYLHSLNIVHRDIKPENLLVYEHQDGSKSLKLGDFGLATIVDGPLYTVCGTPTYVAPEIIAETGYGLKVDIWAAGVITYILLCGFPPFRGSGDDQEVLFDQILMGQVDFPSPYWDNVSDSAKELITMMLLVDVDQRFSAVQVLEHPWVN'
            seq1_mod = null
            seq1_cyclic = false
            seq1_genmsa = true
            
            // DCLK1-IN-1 inhibitor
            lig1_chain_id = 'L'
            lig1_ccd = null
            lig1_smiles = 'CN1CCN(CC1)C2=CC(=C(C=C2)NC3=NC=C4C(=N3)N(C5=CC=CC=C5C(=O)N4CC(F)(F)F)C)OC'
            affinity_ligand_id = 'L'
            affinity_mw_correction = true
        }
    }
    
    // =====================================
    // PROFILE 2: EphA4 with template
    // =====================================
    epha4_template {
        params {
            pred_name = 'epha4_template_4BKF_3'
            
            // EphA4 (P54764)
            seq1_type = 'protein'
            seq1_chain_id = 'A,B'
            seq1_seq = ''
            seq1_mod = null
            seq1_cyclic = false
            seq1_genmsa = true
            
            // Template from EphA4 structure (PDB: 4BKF)
            template1_path = './templates/4BKF.cif'
            //template1_threshold = 3
        }
    }
    
    // =====================================
    // PROFILE 3: PEAK3 phosphopeptide + 14-3-3 + Crk-II (2 copies each)
    // =====================================
    peak3_1433_crkii {
        params {
            pred_name = 'peak3_1433_crkii'
            
            // PEAK3 phosphopeptide (short sequence with phospho-serine)
            seq1_type = 'protein'
            seq1_chain_id = 'A,B'
            seq1_seq = 'PLPPPLPKKILTRTQSLPTRR'
            seq1_mod = '[16,SEP]'  // Phospho-serine at position 4 (S in RTQSLP)
            seq1_cyclic = false
            seq1_genmsa = false   // No MSA for short peptide
            
            // Human 14-3-3 zeta (UniProt P63104)
            seq2_type = 'protein'
            seq2_chain_id = 'C,D'
            seq2_seq = 'MDKNELVQKAKLAEQAERYDDMAACMKSVTEQGAELSNEERNLLSVAYKNVVGARRSSWRVVSSIEQKTEGAEKKQQMAREYREKIETELRDICNDVLSLLEKFLIPNASQAESKVFYLKMKGDYYRYLAEVAAGDDKKGIVDQSQQAYQEAFEISKKEMQPTHPIRLGLALNFSVFYYEILNSPEKACSLAKTAFDEAIAELDTLSEESYKDSTLIMQLLRDNLTLWTSDTQGDEAEAGEGGEN'
            seq2_mod = null
            seq2_cyclic = false
            seq2_genmsa = true
        
            // Human CrkII (UniProt P46108)
            seq3_type = 'protein'
            seq3_chain_id = 'E,F'
            seq3_seq = ''
            seq3_mod = null
            seq3_cyclic = false
            seq3_genmsa = true
        }
    }
}
