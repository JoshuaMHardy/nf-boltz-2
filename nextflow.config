params {
        // =====================================
        // INPUT/OUTPUT
        // =====================================

        // Prediction run name. Only letters, numbers, underscores, and dashes allowed.
        pred_name = 'test'
        // Output directory. Existing results will be overwritten
        outdir = '/vast/scratch/users/hardy.j/boltztest'
        // Input YAML file. If provided, parameters below will be ignored. The name of the yaml file will be the prediction name.
        input_yaml = null

        // =====================================
        // SEQUENCES (Proteins, DNA, RNA)
        // =====================================
        
        // Optional name used in plots. Only letters, numbers, underscores, and dashes allowed.
        seq1_name = null

        // Choose from 'protein', 'dna', 'rna'
        seq1_type = 'protein'
        
        // Unique ID(s)
        seq1_chain_id = 'A'
        
        // Sequence
        seq1_seq = 'ADNKFNKEQQNAFYEILHLPNLTEEQRNGFIQSLKDDPSVSKEILAEAKKLNDAQAPK'
        
        // Sequence modifications [RESIDX,CCD][RESIDX,CCD]...
        seq1_mod = null
        
        // Is sequence cyclic?
        seq1_cyclic = false
        
        // Whether to generate MSA
        seq1_genmsa = true
        
        seq2_name = null
        seq2_type = null
        seq2_chain_id = null
        seq2_seq = null
        seq2_mod = null
        seq2_cyclic = false
        seq2_genmsa = true

        seq3_name = null
        seq3_type = null
        seq3_chain_id = null
        seq3_seq = null
        seq3_mod = null
        seq3_cyclic = false
        seq3_genmsa = true

        seq4_name = null
        seq4_type = null
        seq4_chain_id = null
        seq4_seq = null
        seq4_mod = null
        seq4_cyclic = false
        seq4_genmsa = true

        seq5_name = null
        seq5_type = null
        seq5_chain_id = null
        seq5_seq = null
        seq5_mod = null
        seq5_cyclic = false
        seq5_genmsa = true

        seq6_name = null
        seq6_type = null
        seq6_chain_id = null
        seq6_seq = null
        seq6_mod = null
        seq6_cyclic = false
        seq6_genmsa = true

        seq7_name = null
        seq7_type = null
        seq7_chain_id = null
        seq7_seq = null
        seq7_mod = null
        seq7_cyclic = false
        seq7_genmsa = true

        seq8_name = null
        seq8_type = null
        seq8_chain_id = null
        seq8_seq = null
        seq8_mod = null
        seq8_cyclic = false
        seq8_genmsa = true

        seq9_name = null
        seq9_type = null
        seq9_chain_id = null
        seq9_seq = null
        seq9_mod = null
        seq9_cyclic = false
        seq9_genmsa = true

        seq10_name = null
        seq10_type = null
        seq10_chain_id = null
        seq10_seq = null
        seq10_mod = null
        seq10_cyclic = false
        seq10_genmsa = true

        seq11_name = null
        seq11_type = null
        seq11_chain_id = null
        seq11_seq = null
        seq11_mod = null
        seq11_cyclic = false
        seq11_genmsa = true

        seq12_name = null
        seq12_type = null
        seq12_chain_id = null
        seq12_seq = null
        seq12_mod = null
        seq12_cyclic = false
        seq12_genmsa = true

        // =====================================
        // LIGANDS (Small molecules, ions, etc.)
        // =====================================

        // Unique ID(s) e.g. 'D'
        lig1_chain_id = null
        // CCD code e.g. 'ZN', 'ATP'
        lig1_ccd = null
        // SMILES string e.g. 'CCO', '[Ca+2]', 'CC(=O)Nc1ccc(O)cc1)''
        lig1_smiles = null

        lig2_chain_id = null
        lig2_ccd = null
        lig2_smiles = null

        lig3_chain_id = null
        lig3_ccd = null
        lig3_smiles = null

        lig4_chain_id = null
        lig4_ccd = null
        lig4_smiles = null

        lig5_chain_id = null
        lig5_ccd = null
        lig5_smiles = null

        lig6_chain_id = null
        lig6_ccd = null
        lig6_smiles = null

        lig7_chain_id = null
        lig7_ccd = null
        lig7_smiles = null

        lig8_chain_id = null
        lig8_ccd = null
        lig8_smiles = null

        lig9_chain_id = null
        lig9_ccd = null
        lig9_smiles = null

        lig10_chain_id = null
        lig10_ccd = null
        lig10_smiles = null

        lig11_chain_id = null
        lig11_ccd = null
        lig11_smiles = null

        lig12_chain_id = null
        lig12_ccd = null
        lig12_smiles = null

        // =====================================
        // CONSTRAINTS
        // =====================================
        // Bond constraints. Each bond constraint is provided as a pair of atoms. Multiple bonds can be specified, seperated by spaces.
        // For both atoms that form each bond, provide the chain ID, res number, and atom name.
        // Format: '[CHAIN_ID, RES_IDX, ATOM_NAME][CHAIN_ID, RES_IDX, ATOM_NAME] [CHAIN_ID,RES_IDX, ATOM_NAME][CHAIN_ID, RES_IDX, ATOM_NAME]...'
        // e.g. '[A,33,O][B,1,N] [H,95,SG][L,23,SG]'
        constraints_bond = null
        // Pocket constraints. Multiple pockets can be specified, seperated by spaces.
        // For each pocket, specify the ID of the binder and a list of the pocket residues/atoms. Optionally provide the max distance in Angstroms of the ligand from the pocket (default: 6), and whether to use a potential to enforce the pocket constraint (default: false).
        // Format: '[BINDER_ID][[POCKET_CHAIN_ID,RES_IDX/ATOM_NAME],[POCKET_CHAIN_ID,RES_IDX/ATOM_NAME],...][DIST_ANGSTROM][FORCE_BOOLEAN]'
        // e.g. '[B][[A,53],[A,57],[A,61]] [C][[A,101],[A,130]][5][true]'
        constraints_pocket = null
        // Contact constraints provided as pairs of residues or atoms. Multiple contacts can be specified, seperated by spaces.
        // For each contact, provide: a pair of chain IDs and residue/atoms. Optionally provide a max distance in Angstroms (default: 6) and whether to use a potential to enforce the contact (default: false).
        // Format: '[CHAIN_ID,RES_IDX/ATOM_NAME][CHAIN_ID,RES_IDX/ATOM_NAME][DIST_ANGSTROM][FORCE_BOOLEAN]'
        // e.g. '[A,53][A,57] [A,101][A,130][5][true]'        
        constraints_contacts = null

        // =====================================
        // TEMPLATES
        // =====================================
        // Structural templates (for protein sequences only). Multiple templates can be specified, seperated by spaces.
        // Each template block consists of a path to a CIF file, the prediction chain ID(s) to be templated, template chain ID(s), whether to use a force potential (default: false), and the distance in Angstroms that the prediction can deviate from the template (required when force=true, default='inf')
        // Format: '[CIF_PATH][PREDICTION_IDs][TEMPLATE_IDs][FORCE_BOOLEAN][THRESHOLD_ANGSTROM]'
        // If chain IDs are not provided, Boltz will automatically match prediction chains to template chains i.e. to automatically match leave one or both chain ID elements empty
        // e.g. '['./template.cif'][][]' will match all template chains to prediction chains, '['./template.cif'][A][]' will only find templates for chain A, '['./template.cif'][][Y]' will match chain Y of template to
        // You can explicitly map prediction chains to templates e.g. To map chain A to template chain Y, and map chain D to template chain Z '['./template.cif'][C,D][Y,Z]'
        // You can use the same template chain for multiple prediction chains. e.g. To map chains A and B to template chain Y, and use a potential with a threshold of 5 angstroms during prediction '['./template.cif'][A,B][Y,Y][true][5]'
        templates = null

        // =====================================
        // AFFINITY
        // =====================================
        // Chain ID of ligand for affinity calculations e.g. 'E', 'L1', 'D'
        affinity_ligand_id = null
        // Whether to add the Molecular Weight correction to the affinity value head. Boolean.
        affinity_mw_correction = false
        // The number of diffusion samples to use for affinity prediction. More samples improve quality but increase computation time. Default: 5 
        diffusion_samples_affinity = null
        // Number of sampling steps for affinity prediction. Default: 200
        sampling_steps_affinity = null

        // =====================================
        // BOLTZ-2 PARAMETERS
        // =====================================

        // The number of diffusion samples to use for prediction. (default: 1)
        diffusion_samples = null
        // Method conditioning to use. (default: 'x-ray crystallography')
        // Choose from: 'afdb', 'boltz-1', 'md', 'electron microscopy', 'solution-nmr', 'x-ray crystallography', or 'other' 
        method = null
        // The number of recycling steps to use for prediction. (default: 10)
        recycling_steps = null
        // The number of sampling steps to use for prediction. (default: 200)
        sampling_steps = null
        // Boltz prediction output format. Choose from 'mmcif' or 'pdb' (default: 'pdb')
        output_format = 'pdb'
        // Whether to save the full PAE matrix as a file
        write_full_pae = true
        // Whether to save the full PDE matrix as a file
        write_full_pde = true
        // Additional configuration parameters to pass to Boltz-2 that are not externalised in Nextflow. e.g. '--msa_pairing_strategy complete'
        extra_config = null
        // Path to the Boltz-2 container
        container_path = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/21_05/boltz2.sif'
        // Path to the Boltz-2 models
        models_path = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/boltzmodels'
        // GPU model requested (choose from 'A30' or 'A100')
        gpu_model = 'A30'
        // Number of CPUs requested
        n_cpus = 24
        // Memory requested
        memory = '48G'
}
