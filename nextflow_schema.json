{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/your-org/nf-boltz/master/nextflow_schema.json",
  "title": "nf-boltz pipeline parameters",
  "description": "Nextflow pipeline for protein structure prediction using Boltz-1",
  "type": "object",
  "definitions": {
    "input_output_options": {
      "title": "Input/Output options",
      "type": "object",
      "fa_icon": "fas fa-file-import",
      "description": "Define where the pipeline should find input data and save output data",
      "required": [
        "pred_name"
      ],
      "properties": {
        "pred_name": {
          "type": "string",
          "description": "Prediction run name",
          "help_text": "Only letters, numbers, underscores, and dashes allowed. Used as prefix for output files. e.g. protein_complex', 'antibody_design', 'my_prediction'",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "default": "test"
        },
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "Output directory path",
          "help_text": "The output directory where the results will be saved. Existing results with the same prediction name will be overwritten.",
          "default": "/vast/scratch/users/hardy.j/boltztest"
        },
        "input_yaml": {
          "type": "string",
          "format": "file-path",
          "description": "Path to input YAML files or directory of YAML files. If provided, this will ignore all sequence, ligand, constraints parameters below.",
          "help_text": "e.g. '/path/to/input.yml'. The name of each yaml file will be used for the prediction name."
        }
      }
    },
    "boltz_options": {
      "title": "Boltz-1 prediction options",
      "type": "object",
      "fa_icon": "fas fa-cogs",
      "description": "Configure Boltz-1 prediction parameters",
      "properties": {
        "boltz_diffusion_samples": {
          "type": "integer",
          "description": "Number of diffusion samples",
          "minimum": 1,
          "maximum": 25,
          "default": 1,
          "help_text": "Number of independent diffusion samples to generate. More samples improve quality but increase computation time."
        },
        "boltz_recycling_steps": {
          "type": "integer",
          "description": "Number of recycling steps",
          "minimum": 1,
          "maximum": 20,
          "default":10,
          "hidden": true,
          "help_text": "More steps generally improve accuracy but increase computation time. Default = 10, same as AlphaFold3."
        },
        "boltz_sampling_steps": {
          "type": "integer",
          "description": "Number of sampling steps",
          "minimum": 50,
          "maximum": 1000,
          "default": 200,
          "hidden": true,
          "help_text": "Number of denoising steps in the diffusion process"
        },
        "boltz_write_full_pae": {
          "type": "boolean",
          "default": true,
          "description": "Whether to save the full PAE matrix as a file",
          "hidden": true
        },
        "boltz_write_full_pde": {
            "type": "boolean",
            "default": true,
            "description": "Whether to save the full PDE matrix as a file",
            "hidden": true
        },
        "boltz_extra_config": {
          "type": "string",
          "description": "Additional Boltz-1 configuration",
          "hidden": true,
          "help_text": "Extra command-line arguments for Boltz-1 (e.g., '--msa_pairing_strategy complete --confidence_threshold 0.7')"
        }
      }
    },
    "sequence_1_options": {
      "title": "Sequence 1 options",
      "type": "object",
      "fa_icon": "fas fa-dna",
      "description": "Configure sequence 1 (protein, DNA, or RNA)",
      "properties": {
        "seq1_type": {
          "type": "string",
          "description": "Sequence 1 type",
          "enum": [
            "protein",
            "dna",
            "rna"
          ],
          "help_text": "Choose the biomolecule type for sequence 1. Examples: protein, dna, rna",
          "default": "protein"
        },
        "seq1_id": {
          "type": "string",
          "description": "Sequence 1 chain ID(s)",
          "pattern": "^[A-Za-z0-9]+(,[A-Za-z0-9]+)*$",
          "help_text": "Single chain ID (e.g., 'A') or multiple IDs separated by commas (e.g., 'A,B,C'). Examples: A, B,C, H,L",
          "default": "A"
        },
        "seq1_seq": {
          "type": "string",
          "description": "Sequence 1 amino acid/nucleotide sequence",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXZ*-]+$",
          "minLength": 1,
          "maxLength": 10000,
          "help_text": "Single-letter amino acid codes for proteins, ATCG for DNA, AUCG for RNA. Example: ADNKFNKEQQNAFYEILHLPNLTEEQRNGFIQSLKDDPSVSKEILAEAKKLNDAQAPK",
          "default": "ADNKFNKEQQNAFYEILHLPNLTEEQRNGFIQSLKDDPSVSKEILAEAKKLNDAQAPK"
        },
        "seq1_mod": {
          "type": "string",
          "description": "Sequence 1 modifications",
          "pattern": "^(\\[\\d+,[A-Z0-9]{3}\\])+$",
          "help_text": "Format: [position,CCD_code][position,CCD_code]... e.g. '[33,SEP]', '[10,PTR][25,TPO]', '[1,ACE][50,NH2]'",
          "default": "[33,SEP][42,SEP]"
        },
        "seq1_cyclic": {
          "type": "boolean",
          "hidden": true,
          "description": "Is sequence 1 cyclic?",
          "help_text": "Set to true for cyclic peptides or circular DNA/RNA"
        },
        "seq1_genmsa": {
          "type": "boolean",
          "hidden": true,
          "description": "Generate MSA for sequence 1",
          "default": true,
          "help_text": "Generate multiple sequence alignment to improve prediction accuracy"
        }
      },
      "required": [
        "seq1_type",
        "seq1_id",
        "seq1_seq"
      ]
    },
