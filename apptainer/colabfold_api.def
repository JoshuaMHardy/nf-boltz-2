Bootstrap: docker
From: python:3.10-slim

%post
    # Update package lists
    apt-get update && apt-get install -y \
        curl \
        wget \
        ca-certificates \
        tar \
        gzip \
        && rm -rf /var/lib/apt/lists/*
    
    # Install Python dependencies
    pip install --no-cache-dir \
        requests==2.31.0 \
        biopython==1.83
    
    # Clean up
    apt-get clean
    
%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1

    
%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1

%labels
    Author hardy.j@wehi.edu.au
    Version v1.0.0
    Description Container for ColabFold API interactions and MSA processing

%help
    This container provides Python 3.10 with requests and biopython
    for ColabFold API interactions and MSA format conversion.
    
    Usage:
        apptainer exec colabfold_api.sif python script.py
